# the base url of the application, the default is "/"
# if use a sub directory, it must be end with "/", like "/admin/" but not "/admin"
VITE_BASE_URL=/

VITE_APP_TITLE=Carlos Admin

VITE_APP_DESC=Carlos Framework Admin System

# 应用版本号（Carlos Framework 平台版本，与后端 carlos-framework 保持一致）
# 注意：不要用 package.json 的 version —— 那是上游 soybean 模板的版号（1.3.11）
VITE_APP_VERSION=3.0.0-SNAPSHOT

# the prefix of the icon name
VITE_ICON_PREFIX=icon

# the prefix of the local svg icon component, must include VITE_ICON_PREFIX
# format {VITE_ICON_PREFIX}-{local icon name}
VITE_ICON_LOCAL_PREFIX=icon-local

# auth route mode: static ｜ dynamic
VITE_AUTH_ROUTE_MODE=dynamic

# static auth route home
VITE_ROUTE_HOME=home

# default menu icon
VITE_MENU_ICON=mdi:menu

# whether to enable http proxy when is dev mode
# backend service base url
VITE_SERVICE_BASE_URL=http://127.0.0.1:9510

VITE_HTTP_PROXY=Y

# vue-router mode: hash | history | memory
VITE_ROUTER_HISTORY_MODE=history

# success code of backend service, when the code is received, the request is successful
VITE_SERVICE_SUCCESS_CODE=00000

# logout codes of backend service, when the code is received, the user will be logged out and redirected to login page
VITE_SERVICE_LOGOUT_CODES=A0001,A0002

# modal logout codes of backend service, when the code is received, the user will be logged out by displaying a modal
VITE_SERVICE_MODAL_LOGOUT_CODES=

# token expired codes of backend service, when the code is received, it will refresh the token and resend the request
VITE_SERVICE_EXPIRED_TOKEN_CODES=A0004

# when the route mode is static, the defined super role
VITE_STATIC_SUPER_ROLE=R_SUPER

# Used to differentiate storage across different domains
VITE_STORAGE_PREFIX=CARLOS_

# used to control whether the program automatically detects updates
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# ======================== SSO OIDC 配置 ========================
# IdP 地址（carlos-auth 部署地址，开发环境通常与 carlos-framework-ui 同域或独立部署）
VITE_AUTH_IDP_URL=http://127.0.0.1:9511
# OAuth2 客户端 ID（在 carlos-auth 中注册）
VITE_AUTH_CLIENT_ID=carlos-framework-ui

# S2 租户管理：登录页租户编码输入开关（需与后端 carlos.auth.tenant.enabled 同步开启）
VITE_AUTH_TENANT_ENABLED=false
